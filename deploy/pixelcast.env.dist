# Base URL of the device REST API, including the /api suffix. Must be an IP
# address: an mDNS name such as pixelcast.local never resolves inside the image.
PIXELCAST_DEVICE_BASE_URL=http://192.168.1.174/api

# API keys of the financial data providers. They are read from the environment,
# never from pixelcast.yaml, which rejects any key it does not declare. Uncomment
# the one matching a tracker group you enable.
#PIXELCAST_COINGECKO_API_KEY=
#PIXELCAST_TWELVEDATA_API_KEY=

# Credentials of the Claude session this host owns. Written by `app:claude:login`,
# rotated at every refresh, and never edited by hand. The path must sit inside a
# directory bind mount: the file is replaced by rename(), which a single-file mount
# does not follow.
#
# This host needs its OWN login. Copying a workstation's ~/.claude/.credentials.json
# over creates a race where the first machine to refresh logs the other out — the
# refresh token rotates, and whoever refreshes owns it from then on.
#PIXELCAST_CLAUDE_CREDENTIALS_FILE=/app/claude/credentials.json
