{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/nicolas-codemate/pixelcast-client/main/pixelcast.schema.json",
    "title": "PixelCast client configuration",
    "description": "Contract of pixelcast.yaml. API keys are never written here, they are read from the environment.",
    "type": "object",
    "required": [
        "syncs"
    ],
    "additionalProperties": false,
    "properties": {
        "syncs": {
            "description": "Sync groups, keyed by sync type. Omitting a group is the same as disabling it.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
                "weather": {
                    "$ref": "#/definitions/weatherSync"
                },
                "coingecko": {
                    "$ref": "#/definitions/trackerSync"
                },
                "twelvedata": {
                    "$ref": "#/definitions/trackerSync"
                },
                "boursorama": {
                    "$ref": "#/definitions/trackerSync"
                }
            }
        }
    },
    "definitions": {
        "weatherSync": {
            "description": "Weather forecast pushed to the device.",
            "type": "object",
            "required": [
                "enabled",
                "interval",
                "latitude",
                "longitude",
                "units",
                "locale"
            ],
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "description": "A disabled group is never scheduled and cannot be dispatched by hand.",
                    "type": "boolean"
                },
                "interval": {
                    "description": "How often the group runs, e.g. \"30 minutes\", \"1 hour\", \"PT30M\", \"1800\". At least 60 seconds.",
                    "type": "string",
                    "minLength": 1
                },
                "latitude": {
                    "description": "Latitude of the location the forecast is fetched for.",
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                },
                "longitude": {
                    "description": "Longitude of the location the forecast is fetched for.",
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                },
                "units": {
                    "description": "Unit system used for temperatures.",
                    "type": "string",
                    "enum": [
                        "metric",
                        "imperial"
                    ]
                },
                "locale": {
                    "description": "Locale used for the 3-letter forecast day labels.",
                    "type": "string",
                    "enum": [
                        "fr",
                        "en"
                    ]
                },
                "staleAfter": {
                    "description": "Silence tolerated by the device before the app is considered stale, in seconds. 0 = never. Without it the value is three times the interval, the same rule the healthcheck applies.",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 604800
                },
                "staleBehavior": {
                    "description": "What the device does with the app once stale. \"hide\" falls back to the clock until the next push, \"none\" keeps showing the last forecast. Without it the firmware default applies.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "hide",
                        "none",
                        null
                    ]
                }
            }
        },
        "trackerSync": {
            "description": "Assets fetched in one batch from a single provider.",
            "type": "object",
            "required": [
                "enabled",
                "interval",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "description": "A disabled group is never scheduled and cannot be dispatched by hand.",
                    "type": "boolean"
                },
                "interval": {
                    "description": "How often the group runs, e.g. \"30 minutes\", \"1 hour\", \"PT30M\", \"1800\". At least 60 seconds.",
                    "type": "string",
                    "minLength": 1
                },
                "items": {
                    "description": "Assets tracked in this group.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/trackerItem"
                    }
                },
                "staleAfter": {
                    "description": "Silence tolerated by the device before the app is considered stale, in seconds. 0 = never. Without it the value is three times the interval, the same rule the healthcheck applies.",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 604800
                },
                "staleBehavior": {
                    "description": "What the device does with the app once stale. \"hide\" leaves the rotation until the next push, \"dim\" stays visible dimmed with a STALE badge, \"badge\" stays at full colour with the badge, \"none\" shows no sign. Without it the firmware default applies.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "hide",
                        "dim",
                        "badge",
                        "none",
                        null
                    ]
                }
            }
        },
        "trackerItem": {
            "type": "object",
            "required": [
                "symbol",
                "currency"
            ],
            "additionalProperties": false,
            "properties": {
                "symbol": {
                    "description": "Identifier of the asset for this provider.",
                    "type": "string",
                    "minLength": 1
                },
                "currency": {
                    "description": "Currency the asset price is quoted in.",
                    "type": "string",
                    "minLength": 1
                },
                "icon": {
                    "description": "Identifier of the icon shown next to the asset on the device.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "label": {
                    "description": "Text shown on the top row instead of the symbol derived from the provider identifier.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "maxLength": 31
                },
                "labelColor": {
                    "description": "Hex color of the label. Without it the label follows the trend color, like the sparkline.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "bottomText": {
                    "description": "Text shown under the price.",
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1,
                    "maxLength": 31
                }
            }
        }
    }
}
