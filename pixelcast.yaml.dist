# yaml-language-server: $schema=https://raw.githubusercontent.com/nicolas-codemate/pixelcast-client/main/pixelcast.schema.json

# The directive above is an editing aid only: it makes the editor complete keys and
# flag mistakes, reading the schema published on the main branch. The schema that
# actually accepts or rejects this file is the copy embedded in the image, applied
# every time the configuration is loaded.

# Sync groups, keyed by sync type. The key is also what `app:sync <type>` accepts.
# Omitting a group is the same as disabling it.
syncs:
    weather:
        # A disabled group is never scheduled and cannot be dispatched by hand.
        enabled: true

        # How often the group runs, e.g. '30 minutes', '1 hour', 'PT30M', '1800'. At least 60 seconds.
        interval: '30 minutes'

        # Latitude of the location the forecast is fetched for.
        latitude: 48.8566

        # Longitude of the location the forecast is fetched for.
        longitude: 2.3522

        # Unit system used for temperatures (metric or imperial).
        units: metric

        # Locale used for the 3-letter forecast day labels (fr or en).
        locale: fr

        # Silence tolerated by the device before the app is considered stale, in seconds. 0 = never,
        # 604800 (7 days) at most. Without this key the value is three times the interval, the same
        # rule the healthcheck applies, so '30 minutes' gives 5400.
        # staleAfter: 5400

        # What the device does with the app once stale. Here only hide or none: hide falls back to
        # the clock until the next push, none keeps showing the last forecast. Without this key the
        # firmware default applies.
        # staleBehavior: hide

    # Crypto assets read from CoinGecko in a single call per currency. Its API key is
    # read from PIXELCAST_COINGECKO_API_KEY, never from this file, which rejects any
    # key it does not declare.
    coingecko:
        # A disabled group is never scheduled and cannot be dispatched by hand.
        enabled: false

        # How often the group runs, e.g. '30 minutes', '1 hour', 'PT30M', '1800'. At least 60 seconds.
        interval: '5 minutes'

        # Silence tolerated by the device before the app is considered stale, in seconds. 0 = never,
        # 604800 (7 days) at most. Without this key the value is three times the interval, the same
        # rule the healthcheck applies, so '5 minutes' gives 900.
        # staleAfter: 900

        # What the device does with the app once stale: hide leaves the rotation until the next push,
        # dim stays visible dimmed with a STALE badge, badge stays at full colour with the badge,
        # none shows no sign. Without this key the firmware default applies.
        # staleBehavior: dim

        # Assets tracked in this group.
        # symbol: identifier of the asset for this provider, a coin id for CoinGecko.
        # currency: currency the asset price is quoted in.
        # icon: name of the icon shown next to the asset on the device, optional.
        # label: text shown on the top row instead of the text derived from symbol, optional.
        # labelColor: hex color of the label, optional. Without it the label follows the trend color.
        # bottomText: text shown under the price, optional. Here it replaces the 24 hour volume.
        items:
            - symbol: bitcoin
              currency: eur
              icon: bitcoin

    # Stocks, ETFs and indices read from Twelve Data in a single call. Its API key is
    # read from PIXELCAST_TWELVEDATA_API_KEY, never from this file, which rejects any
    # key it does not declare.
    twelvedata:
        # A disabled group is never scheduled and cannot be dispatched by hand.
        enabled: false

        # How often the group runs, e.g. '30 minutes', '1 hour', 'PT30M', '1800'. At least 60 seconds.
        interval: '15 minutes'

        # Silence tolerated by the device before the app is considered stale, in seconds. 0 = never,
        # 604800 (7 days) at most. Without this key the value is three times the interval, the same
        # rule the healthcheck applies, so '15 minutes' gives 2700.
        # staleAfter: 2700

        # What the device does with the app once stale: hide leaves the rotation until the next push,
        # dim stays visible dimmed with a STALE badge, badge stays at full colour with the badge,
        # none shows no sign. Without this key the firmware default applies.
        # staleBehavior: dim

        # Assets tracked in this group.
        # symbol: identifier of the asset for this provider, a ticker for Twelve Data.
        # currency: only a fallback here. Twelve Data quotes every asset in the currency of its
        #   exchange and converts nothing, so the currency it reports wins over this value.
        # icon: name of the icon shown next to the asset on the device, optional.
        # label: text shown on the top row instead of the text derived from symbol, optional.
        # labelColor: hex color of the label, optional. Without it the label follows the trend color.
        # bottomText: text shown under the price, optional.
        items:
            - symbol: AAPL
              currency: usd
              icon: stock
            - symbol: IWDA.AS
              currency: eur
              icon: etf
            - symbol: IXIC
              currency: usd
              icon: stock

    # European ETFs read from Boursorama, one call per asset. This source needs no API key,
    # but it is an internal endpoint under no commitment and can change without notice.
    boursorama:
        # A disabled group is never scheduled and cannot be dispatched by hand.
        enabled: false

        # How often the group runs, e.g. '30 minutes', '1 hour', 'PT30M', '1800'. At least 60 seconds.
        interval: '15 minutes'

        # Silence tolerated by the device before the app is considered stale, in seconds. 0 = never,
        # 604800 (7 days) at most. Without this key the value is three times the interval, the same
        # rule the healthcheck applies, so '15 minutes' gives 2700.
        # staleAfter: 2700

        # What the device does with the app once stale: hide leaves the rotation until the next push,
        # dim stays visible dimmed with a STALE badge, badge stays at full colour with the badge,
        # none shows no sign. Without this key the firmware default applies.
        # staleBehavior: hide

        # Hours during which the group is scheduled: outside them nothing is fetched and the
        # healthcheck does not watch the group. Without this key the group runs around the clock.
        # days: days the window is open, among mon, tue, wed, thu, fri, sat, sun. Without it, every day.
        # from and to: HH:MM, both inclusive. A window spanning midnight is refused, so declare it
        #   in the timezone of the market, where it does not cross midnight.
        # timezone: the timezone from and to are read in. A market opens at a local hour, not at the
        #   hour of the container clock, which runs in UTC.
        activeWindow:
            days: [mon, tue, wed, thu, fri]
            from: '09:00'
            to: '17:45'
            timezone: Europe/Paris

        # Assets tracked in this group.
        # symbol: Boursorama code of the asset, not its ISIN. The code of an ISIN is found on
        #   https://www.boursorama.com/recherche/ajax?query=<ISIN>, once, by hand.
        # currency: authoritative here. The response carries no currency at all.
        # icon: name of the icon shown next to the asset on the device, optional.
        # label: text shown on the top row instead of the text derived from symbol, optional.
        # labelColor: hex color of the label, optional. Without it the label follows the trend color.
        # bottomText: text shown under the price, optional.
        items:
            - symbol: 1rTDCAM
              currency: eur
              icon: etf
              label: Amundi PEA Monde
              labelColor: '#4CAF50'
              bottomText: MSCI World
